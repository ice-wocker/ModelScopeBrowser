<?xml version="1.0" encoding="utf-8"?>
<!--
  本地模型动辄数百 MB~数 GB，不参与 Auto Backup，否则备份必然超配额失败（24MB 上限），
  结果是连对话历史、语言设置这些真正该备份的小文件也一起失败。
  模型实际落在 getExternalFilesDir()/models，对应下面 external 域；这里再补两条 internal/root
  路径，防止以后把模型目录挪回私有目录时漏掉。
  workspace 是智能体读写文件的目录，同样可能有几百 MB 的大文件，一并排除 —— 真正需要
  跟着用户走的是 chats.json 与语言设置，那些仍然在备份范围内。
-->
<full-backup-content>
    <exclude domain="external" path="models" />
    <exclude domain="root" path="models" />
    <exclude domain="file" path="models" />
    <exclude domain="file" path="workspace" />
</full-backup-content>
