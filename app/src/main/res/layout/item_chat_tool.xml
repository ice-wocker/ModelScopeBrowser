<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="44dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/ivTool"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_avatar_ai"
        android:contentDescription="@string/chat_tool_info"
        android:padding="6dp"
        android:src="@drawable/ic_terminal"
        app:tint="@color/brand" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_bubble_tool"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvToolTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="270dp"
            android:textColor="@color/brand"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvToolBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:maxWidth="270dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvToolHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/chat_tap_workspace"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>