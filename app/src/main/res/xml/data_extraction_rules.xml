<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移规则：本地模型不进云备份，也不随换机迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="models" />
    </device-transfer>
</data-extraction-rules>